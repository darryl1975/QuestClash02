# Ollama host. Defaults to Ollama Cloud (https://ollama.com); set OLLAMA_API_KEY
# below for cloud inference. Point OLLAMA_BASE_URL at a local daemon instead
# (e.g. http://localhost:11434) to use locally-hosted models.
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=

# MySQL connection
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Generation tuning
GENERATION_MAX_ATTEMPTS=3
MC_OPTION_COUNT=4
MAX_SOURCE_CHARS=16000

PORT=8010

# Langfuse observability (leave blank to disable tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# OpenAI (used as the LLM judge for quiz quality metrics; leave blank to disable quality scoring)
OPENAI_API_KEY=
OPENAI_JUDGE_MODEL=gpt-4o-mini
